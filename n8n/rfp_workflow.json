{
  "name": "RFP Response Architect Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rfp-upload",
        "options": {}
      },
      "id": "cbf658a5-cc33-4526-9e2f-8eda0d7eada4",
      "name": "Webhook - Receive Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        464,
        -192
      ],
      "webhookId": "90ac5bf8-e684-4835-accb-4fc05e114985",
      "notes": "Receives the POST from Next.js after a PDF is uploaded. Expected JSON body: { rfp_id, storage_path, file_name }."
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "rfp_documents",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.rfp_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "processing"
            }
          ]
        }
      },
      "id": "cb56ff7f-106e-434b-b443-03760fcbe555",
      "name": "Supabase - Mark Processing",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        704,
        -192
      ],
      "credentials": {
        "supabaseApi": {
          "id": "vaZkCjA5hrt5i4c2",
          "name": "Supabase account"
        }
      },
      "notes": "Updates rfp_documents.status from uploaded to processing for the incoming rfp_id."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://jgfivfrtefeepexsqrfm.supabase.co/storage/v1/object/sign/rfp-uploads/' + $('Webhook - Receive Upload').item.json.body.storage_path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"expiresIn\": 3600 }",
        "options": {}
      },
      "id": "910bd092-8bbb-4d2f-a9e2-bc5bf159446e",
      "name": "HTTP - Create Signed URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        944,
        -192
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "rRGpDPbAiWhcKxoW",
          "name": "Header Auth account"
        }
      },
      "notes": "Creates a short-lived signed Supabase Storage URL for the private PDF object in the rfp-uploads bucket."
    },
    {
      "parameters": {
        "url": "={{ 'https://jgfivfrtefeepexsqrfm.supabase.co/storage/v1' + $json.signedURL }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "rfp_pdf"
            }
          }
        }
      },
      "id": "341b0cd0-9fa8-4c58-999d-99213b658cbd",
      "name": "HTTP - Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1184,
        -192
      ],
      "notes": "Downloads the PDF bytes from Supabase Storage using the signed URL. The binary output is stored as rfp_pdf."
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "rfp_pdf",
        "options": {}
      },
      "id": "b7ab63cf-6b6f-446e-a539-4f9985e417ad",
      "name": "Extract From File - PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1424,
        -192
      ],
      "notes": "Extracts raw text from the downloaded PDF so FastAPI can receive the current /process-rfp contract: { rfp_text, rfp_id }."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/process-rfp",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rfp_id: $('Webhook - Receive Upload').item.json.body.rfp_id, rfp_text: $json.text }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "809ae4a0-f965-4d99-bd4c-ef768f68ec64",
      "name": "HTTP - Run FastAPI Crew",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1664,
        -192
      ],
      "notes": "Posts the extracted rfp_text and original rfp_id to FastAPI /process-rfp. FastAPI runs the CrewAI Analyst, Retriever, and Writer sequence."
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "proposals",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "rfp_id",
              "fieldValue": "={{ $('Webhook - Receive Upload').item.json.body.rfp_id }}"
            },
            {
              "fieldId": "draft_markdown",
              "fieldValue": "={{ $json.draft_markdown }}"
            },
            {
              "fieldId": "edited_content",
              "fieldValue": "={{ $json.draft_markdown }}"
            }
          ]
        }
      },
      "id": "17d016a1-a61d-4886-8a0f-3686561d2ecb",
      "name": "Supabase - Insert Proposal",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1904,
        -192
      ],
      "credentials": {
        "supabaseApi": {
          "id": "vaZkCjA5hrt5i4c2",
          "name": "Supabase account"
        }
      },
      "notes": "Creates the proposal record from the FastAPI result, storing the Writer Agent Markdown as both draft_markdown and the initial edited_content."
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "rfp_documents",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Webhook - Receive Upload').item.json.body.rfp_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "draft_ready"
            }
          ]
        }
      },
      "id": "bed2158e-ea60-4aac-b8a0-5af886fca8f9",
      "name": "Supabase - Mark Draft Ready",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2144,
        -192
      ],
      "credentials": {
        "supabaseApi": {
          "id": "vaZkCjA5hrt5i4c2",
          "name": "Supabase account"
        }
      },
      "notes": "Confirms the proposal row has been inserted and leaves rfp_documents.status as draft_ready for dashboard display."
    }
  ],
